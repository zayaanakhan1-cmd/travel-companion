# Travel Companion - environment template.
# Copy to `.env` and fill in real values. NEVER commit `.env`.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
# Comma-separated origins allowed to call the API from a browser.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Geography provider selection
# ---------------------------------------------------------------------------
# Which provider the geography service prefers.
#   countrystatecity -> hosted REST API (needs CSC_API_KEY). Free tier is
#                       limited (100 requests/day as of 2026-10), so it is
#                       rate-limited and falls back when exhausted.
#   open_dataset     -> genuinely free fallback. Builds a local SQLite cache
#                       from the ODbL-licensed countries-states-cities
#                       dataset. No key, no quota, no network at query time.
#   auto             -> use countrystatecity when a key is configured,
#                       otherwise open_dataset. (recommended default)
GEOGRAPHY_PROVIDER=auto

# CountryStateCity REST API key. Optional. Leave blank to run on the open
# dataset only. Get one at https://app.countrystatecity.in (free tier).
# Sent as the `X-CSCAPI-KEY` header. Server-side only - never expose to the
# browser.
CSC_API_KEY=

# Self-imposed cap on CountryStateCity API calls per rolling 24h window.
# The hosted free tier is small; this protects you from burning it. The
# service falls back to the open dataset once the budget is spent.
CSC_DAILY_REQUEST_LIMIT=100

# Open-dataset settings (fallback provider).
# Pinned release of the ODbL dataset, so builds are reproducible.
OPEN_DATASET_URL=https://github.com/dr5hn/countries-states-cities-database/releases/download/v5.0.0-export.1/json-countries%2Bstates%2Bcities.json.gz
OPEN_DATASET_ATTRIBUTION=Data source: countries-states-cities-database (ODbL-1.0), https://github.com/dr5hn/countries-states-cities-database
# Where the generated SQLite cache lives. Git-ignored.
OPEN_DATASET_CACHE_PATH=backend/data/csc.sqlite3
# Auto-build the cache on first use if it is missing.
OPEN_DATASET_AUTO_BUILD=true
# Network timeout (seconds) for downloading the dataset archive.
OPEN_DATASET_DOWNLOAD_TIMEOUT=120

# ---------------------------------------------------------------------------
# Google Maps Platform
# ---------------------------------------------------------------------------
# The backend adapter is UNCONFIGURED by default and intentionally so.
#
# Why: a backend adapter needs a *Web Service* API (Geocoding / Places).
# The Google Maps "Demo Key" is officially supported only for a limited set
# of products - Maps JavaScript API (Dynamic Maps), Places UI Kit, and Maps
# Grounding Lite - and explicitly excludes Web Service APIs and is licensed
# for prototyping only, not production. See docs/google-maps.md.
#
# Therefore: do NOT enable billing and do NOT paste a standard billing key
# here. Leave this blank. The API reports the integration as `unconfigured`.
GOOGLE_MAPS_API_KEY=

# Frontend-only. If you have obtained a Maps Demo Key and accept its terms
# (prototyping, no billing, daily limits), you may place it here so the
# browser can render a Dynamic Map. It is exposed to the browser by design.
# Leave blank to disable the map entirely.
VITE_GOOGLE_MAPS_DEMO_KEY=
